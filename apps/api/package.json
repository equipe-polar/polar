    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.27.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
