NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque-por-um-segredo-forte-com-32-caracteres
JWT_EXPIRES_IN=8h

# Provider de persistencia: "mysql" (oficial) ou "json" (apenas desenvolvimento rapido).
# Em producao (NODE_ENV=production) o mysql e obrigatorio.
DATABASE_PROVIDER=mysql

# MySQL 8+ (obrigatorio quando DATABASE_PROVIDER=mysql).
# Local:  mysql://polar:senha@localhost:3306/polar
# Nuvem (TiDB/Aiven): use a URL do painel e DATABASE_SSL=true
DATABASE_URL=mysql://polar:senha@localhost:3306/polar
DATABASE_SSL=false

# Fallback JSON (apenas DATABASE_PROVIDER=json).
DATABASE_JSON_PATH=apps/api/data/dev-db.json

BOOTSTRAP_ADMIN_EMAIL=admin@pola.local
BOOTSTRAP_ADMIN_PASSWORD=

# Senha unica dos usuarios de demonstracao criados pelo seed (min. 8 caracteres).
SEED_SENHA_PADRAO=
