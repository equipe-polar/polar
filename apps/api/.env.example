NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque-por-um-segredo-forte-com-32-caracteres
JWT_EXPIRES_IN=8h

# Provider de persistencia: "postgres" (oficial) ou "json" (apenas desenvolvimento rapido).
# Em producao (NODE_ENV=production) o postgres e obrigatorio.
DATABASE_PROVIDER=postgres

# PostgreSQL 15+ (obrigatorio quando DATABASE_PROVIDER=postgres).
# Local:    postgresql://polar:senha@localhost:5432/polar
# Supabase: use a connection string do TRANSACTION POOLER (porta 6543) e DATABASE_SSL=true.
#           A conexao direta (5432) nao aguenta o numero de instancias do serverless.
DATABASE_URL=postgresql://polar:senha@localhost:5432/polar
DATABASE_SSL=false

# Fallback JSON (apenas DATABASE_PROVIDER=json).
DATABASE_JSON_PATH=apps/api/data/dev-db.json

# Admin de emergencia criado no boot. Deixe vazio quando o seed ja tiver rodado:
# sem senha definida o bootstrap nem consulta o banco.
BOOTSTRAP_ADMIN_EMAIL=admin@pola.local
BOOTSTRAP_ADMIN_PASSWORD=

# Senha unica dos usuarios de demonstracao criados pelo seed (min. 8 caracteres).
SEED_SENHA_PADRAO=
